{
  "name": "formlayer-plugin-combobox",
  "version": "0.4.0",
  "description": "Accessible combobox field plugin for FormLayer",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "style": "./dist/style.css",
      "import": "./dist/style.css",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && node -e \"require('fs').copyFileSync('src/style.css','dist/style.css')\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "formlayer": "^0.4.0"
  },
  "devDependencies": {
    "formlayer": "file:../..",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
